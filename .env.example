# RakshaPay Environment Configuration Example

# Backend Database
DATABASE_URL=sqlite:///./backend/rakshapay.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/rakshapay

# Security Secret
SECRET_KEY=rakshapay-super-secret-jwt-key-change-in-production-2026

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK (SMS OTP)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
