
# ==========================================
# RakshaPay - Environment Configuration
# ==========================================

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./rakshapay.db

# Production: Render PostgreSQL
# DATABASE_URL=YOUR_RENDER_POSTGRESQL_INTERNAL_URL

# Application Environment & Security
ENV=development
SECRET_KEY=CHANGE_THIS_TO_A_NEW_SECURE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Phone Authentication
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Fraud Detection Configuration
FRAUD_LOW_THRESHOLD=30
FRAUD_HIGH_THRESHOLD=70
HIGH_VALUE_THRESHOLD_RUPEES=50000.0
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TX_COUNT=3
