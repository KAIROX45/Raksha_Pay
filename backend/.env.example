# Database Connection (Supports SQLite for local standalone testing or PostgreSQL for production)
DATABASE_URL=sqlite:///./rakshapay.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/rakshapay
# Application Environment & Security
ENV=development
SECRET_KEY=rakshapay-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Integration
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Phone Authentication (SMS OTP)
# If left empty, system operates in clearly labeled Demo OTP mode (123456)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Configurable Fraud Thresholds (0 to 100 Scale)
FRAUD_LOW_THRESHOLD=30
FRAUD_HIGH_THRESHOLD=70
HIGH_VALUE_THRESHOLD_RUPEES=50000.0
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TX_COUNT=3
